PORT=3080

# --- Database (Phase 1: copy from lifeguru_admin_backend dev .env) ---
# Phase 2 before staging UAT: read replica + support_agent_ro role — see docs/support-agent-db-phase-checklist.md
SUPPORT_DB_HOST=
SUPPORT_DB_PORT=5432
SUPPORT_DB_NAME=
SUPPORT_DB_USER=
SUPPORT_DB_PASS=
SUPPORT_DB_QUERY_TIMEOUT_MS=3000
# SUPPORT_DB_POOL_MAX=5
# Legacy aliases still work: DB_HOST, DB_NAME, DB_USER, DB_PASS

# --- Gemini (empty = template replies only) ---
GEMINI_API_KEY=
GEMINI_SUPPORT_MODEL=gemini-2.5-flash-lite
SUPPORT_LLM_CLASSIFY=true
SUPPORT_LLM_CLASSIFY_TIMEOUT_MS=3500
SUPPORT_LLM_MIRROR_LANGUAGE=true
SUPPORT_LLM_MIRROR_TIMEOUT_MS=6000
# Includes the knowledge-base catalog in the classify call (same request, not a second one).
SUPPORT_LLM_FAQ_SELECT=true
# PUJA_UPDATES_SENDER_LABEL=7619486274 (save as “LifeGuru Puja Updates”)
# SUPPORT_WHATSAPP_DISPLAY=+91 8147560485

# --- SalesIQ ~5s webhook budget ---
SUPPORT_WEBHOOK_BUDGET_MS=5000
SUPPORT_WEBHOOK_RESERVE_MS=250

SUPPORT_SALESIQ_PENDING=false
SUPPORT_SALESIQ_PENDING_MODE=auto
SALESIQ_API_BASE=https://salesiq.zoho.com/api/v2
SALESIQ_SCREEN_NAME=
SALESIQ_OAUTH_TOKEN=
SALESIQ_CLIENT_ID=
SALESIQ_CLIENT_SECRET=
SALESIQ_REFRESH_TOKEN=
SALESIQ_ACCOUNTS_URL=
SUPPORT_ASYNC_MIRROR_TIMEOUT_MS=12000
SUPPORT_FAIL_OPEN_FORWARD=true
SUPPORT_SALESIQ_HANDOFF_NOTES=true

SALESIQ_VERIFY_SIGNATURE=false
SALESIQ_PUBLIC_KEY=

SUPPORT_ROUTING_STRATEGY=rules_first
SUPPORT_FAQ_ENABLED=true
SUPPORT_BURST_MERGE_ROUTING=true
SESSION_STORE=memory

# Local only. Leave false while the URL is public (ngrok).
SUPPORT_DEV_CHATS=false
SUPPORT_DEV_SHADOW=false
SUPPORT_DEV_DEFAULT_PHONE=false
DEFAULT_CHAT_PHONE=
SUPPORT_SMOKE_PHONE=
