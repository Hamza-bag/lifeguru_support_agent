PORT=3080

# Policy
SUPPORT_FAQ_ENABLED=true
SUPPORT_MAX_CLARIFY=2
# Merge rapid follow-up messages into one routing string (default true). Gap ms:
SUPPORT_BURST_MERGE_ROUTING=true
# SUPPORT_BURST_GAP_MS=12000

# Slice 3 — local Admin API (run admin backend on same machine)
# FACTS_MODE=http
# FACTS_API_URL=http://localhost:YOUR_ADMIN_PORT
# FACTS_API_SECRET=same as SUPPORT_AGENT_SECRET in admin .env
# WhatsApp order lookup uses Zoho visitor.phone only unless you opt in below.
# Omit or false = never substitute DEFAULT_CHAT_PHONE (ngrok/WhatsApp test = ask number → human).
SUPPORT_DEV_DEFAULT_PHONE=false
# DEFAULT_CHAT_PHONE=9876543210
# Preflight + smoke: dev phone with orders (optional; else 9876543210)
# SUPPORT_SMOKE_PHONE=9876543210

# Save first real webhook body to logs/salesiq-webhook-sample.json (Step 5).
SALESIQ_CAPTURE_SAMPLE=true

# Skip RSA check for local / ngrok demos. Set true + PEM in production.
SALESIQ_VERIFY_SIGNATURE=false
# PEM from SalesIQ bot → Secure your webhook (use \n for newlines)
SALESIQ_PUBLIC_KEY=

# mock = built-in demo phones. http = Week-2 facts API.
FACTS_MODE=mock
FACTS_API_URL=
FACTS_API_SECRET=
FACTS_API_TIMEOUT_MS=1200

LOG_PAYLOADS=true

# Session: memory (default, single instance) | redis (needs npm install ioredis + REDIS_URL)
SESSION_STORE=memory
# SESSION_TTL_SECONDS=86400
# REDIS_URL=redis://127.0.0.1:6379

# Same Gemini key as lifeguru_core_backend. Leave empty to keep template replies.
GEMINI_API_KEY=
GEMINI_SUPPORT_MODEL=gemini-2.5-flash-lite
# Intent + route (admin / faq / human / clarify). Needs GEMINI_API_KEY.
SUPPORT_LLM_CLASSIFY=true
# rules_first (prod default) = keywords/FAQ before Gemini; llm_first = every open turn calls Gemini.
SUPPORT_ROUTING_STRATEGY=rules_first
# Classify timeout ms (stay under SalesIQ ~5s webhook budget).
# Max wait for Gemini classify (ms). Keep under ~4800 — SalesIQ webhook ~5s total.
# Classify + mirror + Admin must fit in SUPPORT_WEBHOOK_BUDGET_MS (~SalesIQ 5s).
SUPPORT_LLM_CLASSIFY_TIMEOUT_MS=3500
SUPPORT_WEBHOOK_BUDGET_MS=5000
SUPPORT_WEBHOOK_RESERVE_MS=250
# SalesIQ pending + callback (fixes classify + mirror over 5s). Needs OAuth token.
SUPPORT_SALESIQ_PENDING=false
SALESIQ_API_BASE=https://salesiq.zoho.in/api/v2
SALESIQ_SCREEN_NAME=
SALESIQ_OAUTH_TOKEN=
SUPPORT_ASYNC_MIRROR_TIMEOUT_MS=12000
# Open circuit after N 429/5xx/timeouts; pause Gemini calls for cooldown ms.
SUPPORT_LLM_CIRCUIT_FAILURES=5
SUPPORT_LLM_CIRCUIT_COOLDOWN_MS=60000
# Rewrite replies in the user's language/register (Hinglish, polite tone). On by default when GEMINI_API_KEY is set.
SUPPORT_LLM_MIRROR_LANGUAGE=true
# Max mirror wait (actual = min(this, budget minus elapsed classify/Admin))
SUPPORT_LLM_MIRROR_TIMEOUT_MS=6000

# Hard caps (0 = unlimited). Over limit → forward to human, skip Gemini.
# SUPPORT_LLM_MAX_CALLS_MONTH=80000
# SUPPORT_LLM_MAX_TOKENS_MONTH=50000000

